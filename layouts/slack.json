        "mod": "slack",
        "props": {
          "view": "topbar"
        }
      },
      "size": {
        "px": 44
      },
      "window_drag": true
    },
    {
      "id": "body",
      "type": "row",
      "children": [
        {
          "id": "rail",
          "type": "block",
          "content": {
